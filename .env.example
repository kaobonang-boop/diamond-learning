# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Core Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only (config.settings.production) ---
# Either set DATABASE_URL directly...
# DATABASE_URL=postgres://user:password@host:5432/diamond_learning
# ...or set these discrete Postgres variables instead:
POSTGRES_DB=diamond_learning
POSTGRES_USER=diamond_learning
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Ask Tebogo AI provider (apps/chatbot/providers.py) ---
# "echo" needs no key and works out of the box (deterministic fallback replies).
# Switch to "openai" or "anthropic" once you have a real API key — no code
# changes required anywhere else in the app.
AI_PROVIDER=echo
AI_API_KEY=
AI_MODEL=gpt-4o-mini
